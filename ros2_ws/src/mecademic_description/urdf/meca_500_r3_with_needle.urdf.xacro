<?xml version="1.0"?>
<robot name="meca_500_r3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==========================================
       XACRO PARAMETERS
       Units are meters.
       Holder length = 60 mm = 0.060 m
       Needle length = 35 mm = 0.035 m
       Needle diameter = 0.40 mm → radius = 0.0002 m
       TCP from flange = 80 mm = holder_len + needle_len

       COORDINATE CONVENTION (all tool links):
         +X = approach direction (outward from flange)
         Same as meca_axis_6_link native frame.
         meca_frf_fixed has rpy="0 0 0" → NO frame rotation introduced.
       ========================================== -->

  <xacro:property name="holder_len" value="${0.060}"/>
  <xacro:property name="needle_len" value="${0.020}"/>
  <xacro:property name="needle_rad" value="${0.0002}"/>
  <xacro:property name="tcp_offset" value="${holder_len + needle_len}"/>

  <!-- STL in mm? Then use 0.001. If STL is already in meters, use 1 1 1. -->
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- Holder mesh pose relative to holder_link.
       NOTE: holder_link +X is now the approach direction.
       If the holder.stl was originally designed with +Z as approach,
       set holder_rpy="0 -1.57079632679 0" to compensate visually. -->
  <xacro:property name="holder_xyz" value="0 0 0"/>
  <xacro:property name="holder_rpy" value="0 1.57079632679 0"/>

  <!-- Holder mesh path -->
  <xacro:property name="holder_visual_mesh" value="package://mecademic_description/meshes/holder.stl"/>

  <!-- Optional collision mesh -->
  <xacro:property name="holder_collision_mesh" value=""/>


  <!-- ==========================================
       BASE ROBOT
       ========================================== -->

  <!-- Base link is the center of the robot's bottom plate -->
  <link name="meca_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_base_collision.stl"/>
      </geometry>
    </collision>
  </link>


  <!-- Joint 1 -->
  <link name="meca_axis_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j1_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_1_joint" type="revolute">
    <origin xyz="0.012498 0 0.091" rpy="0 0 0"/>
    <parent link="meca_base_link"/>
    <child link="meca_axis_1_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" velocity="2.61799" lower="-3.05433" upper="3.05433"/>
  </joint>


  <!-- Joint 2 -->
  <link name="meca_axis_2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j2_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_2_joint" type="revolute">
    <origin xyz="0 0 0.044" rpy="0 0 0"/>
    <parent link="meca_axis_1_link"/>
    <child link="meca_axis_2_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="2.61799" lower="-1.22173048" upper="1.5708"/>
  </joint>


  <!-- Joint 3 -->
  <link name="meca_axis_3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j3_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_3_joint" type="revolute">
    <origin xyz="0 0 0.135" rpy="0 0 0"/>
    <parent link="meca_axis_2_link"/>
    <child link="meca_axis_3_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="3.14159" lower="-2.35619" upper="1.22173048"/>
  </joint>


  <!-- Joint 4 -->
  <link name="meca_axis_4_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j4.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j4_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_4_joint" type="revolute">
    <origin xyz="0 0 0.038" rpy="0 0 0"/>
    <parent link="meca_axis_3_link"/>
    <child link="meca_axis_4_link"/>
    <axis xyz="1 0 0"/>
    <limit effort="10.0" velocity="5.23599" lower="-2.96706" upper="2.96706"/>
  </joint>


  <!-- Joint 5 -->
  <link name="meca_axis_5_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j5.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j5_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_5_joint" type="revolute">
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <parent link="meca_axis_4_link"/>
    <child link="meca_axis_5_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="5.23599" lower="-2.00713" upper="2.00713"/>
  </joint>


  <!-- Joint 6 / flange -->
  <link name="meca_axis_6_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j6.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j6_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_6_joint" type="revolute">
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <parent link="meca_axis_5_link"/>
    <child link="meca_axis_6_link"/>
    <axis xyz="1 0 0"/>
    <limit effort="10.0" velocity="8.72665" lower="-3.14159" upper="3.14159"/>
  </joint>


  <!-- ==========================================
       HOLDER + NEEDLE + TCP
       ========================================== -->

  <!-- Meca FRF link.
       rpy="0 0 0" → meca_frf_link is IDENTICAL to meca_axis_6_link frame.
       Approach direction = +X for ALL downstream links.
       No frame rotation is introduced here; the planning script applies
       _RY_MINUS_90 uniformly to both meca_axis_6_link and tcp_link. -->
  <link name="meca_frf_link"/>

  <joint name="meca_frf_fixed" type="fixed">
    <parent link="meca_axis_6_link"/>
    <child link="meca_frf_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- Holder link attached to the Meca FRF.
       holder_link +X is the physical approach direction.
       Collision box and inertia are centered at (holder_len/2, 0, 0). -->
  <link name="holder_link">

    <!-- Holder visual mesh.
         If holder.stl was built with +Z as approach, add rpy="0 -1.57079632679 0"
         to the holder_rpy xacro property at the top to fix the visual orientation. -->
    <visual>
      <origin xyz="${holder_xyz}" rpy="${holder_rpy}"/>
      <geometry>
        <mesh filename="${holder_visual_mesh}" scale="${mesh_scale}"/>
      </geometry>
      <material name="holder_gray">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>

    <!-- Holder collision: box extending holder_len along +X from the flange. -->
    <collision>
      <origin xyz="${holder_len/2.0} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${holder_len} 0.02 0.02"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="${holder_len/2.0} 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>

  </link>

  <joint name="holder_fixed" type="fixed">
    <parent link="meca_frf_link"/>
    <child link="holder_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- Needle link (tool0_link).
       The URDF cylinder primitive is always along the link's local +Z.
       needle_fixed applies Ry(+90°) so that tool0_link local +Z aligns
       with the approach direction (+X of holder_link / meca_axis_6_link).
       Visual/collision geometry uses local Z offsets as usual. -->
  <link name="tool0_link">

    <visual>
      <origin xyz="0 0 ${needle_len/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${needle_len}" radius="${needle_rad}"/>
      </geometry>
      <material name="needle_steel">
        <color rgba="0.75 0.75 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 ${needle_len/2.0}" rpy="0 0 0"/>
      <geometry>
        <!-- Slightly enlarged collision radius for safer planning -->
        <cylinder length="${needle_len}" radius="${needle_rad*1.3}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${needle_len/2.0}" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>

  </link>

  <joint name="needle_fixed" type="fixed">
    <parent link="holder_link"/>
    <child link="tool0_link"/>
    <!-- xyz: needle base is holder_len (60 mm) along holder_link +X (approach).
         rpy: Ry(+90°) rotates tool0_link so its +Z = holder_link +X.
              The cylinder geometry (along local +Z) therefore points along approach. -->
    <origin xyz="${holder_len} 0 0" rpy="0 1.57079632679 0"/>
  </joint>


  <!-- TCP at the needle tip.
       tcp_fixed undoes the Ry(+90°) from needle_fixed with Ry(-90°),
       so tcp_link frame is identical to meca_axis_6_link frame: +X = approach.

       Position: 0 0 needle_len along tool0_link +Z = needle_len along approach.
       Total approach offset from flange: holder_len + needle_len = 0.080 m. -->
  <link name="tcp_link"/>

  <joint name="tcp_fixed" type="fixed">
    <parent link="tool0_link"/>
    <child link="tcp_link"/>
    <!-- xyz: needle_len (20 mm) along tool0_link +Z (= approach direction).
         rpy: Ry(-90°) restores tcp_link frame to match meca_axis_6_link (+X = approach). -->
    <origin xyz="0 0 ${needle_len}" rpy="0 -1.57079632679 0"/>
  </joint>

</robot>
