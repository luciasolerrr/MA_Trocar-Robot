<?xml version="1.0"?>
<robot name="meca_500_r3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==========================================
       XACRO PARAMETERS

       Units are meters.

       Visual tool geometry:
         Holder length = 60 mm = 0.060 m
         Needle visual length = 20 mm = 0.020 m
         Needle diameter = 0.40 mm
         Needle radius = 0.20 mm = 0.0002 m

       Real calibrated Meca500 TCP:
         SetTrf(-0.053, -0.457, 108.751, 0, 0, 0) mm

       Native Meca500 tool convention:
         +Z = approach / insertion direction

       URDF / MoveIt convention used here:
         +X = approach / insertion direction

       Equivalent calibrated TCP offset in this URDF:
         X = +108.751 mm
         Y =   -0.457 mm
         Z =   +0.053 mm

       Therefore:
         tcp_link xyz =
         (0.108751, -0.000457, 0.000053) m
       ========================================== -->

  <xacro:property name="holder_len" value="${0.060}"/>
  <xacro:property name="needle_len" value="${0.020}"/>
  <xacro:property name="needle_rad" value="${0.0002}"/>

  <!-- STL in mm? Then use 0.001.
       If STL is already in meters, use 1 1 1. -->
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- Holder mesh pose relative to holder_link.
       holder_link +X is the approach direction.

       If holder.stl was originally designed with +Z as approach,
       this rotation aligns it visually with holder_link +X. -->
  <xacro:property name="holder_xyz" value="0 0 0"/>
  <xacro:property name="holder_rpy" value="0 1.57079632679 0"/>

  <!-- Holder mesh path -->
  <xacro:property
      name="holder_visual_mesh"
      value="package://mecademic_description/meshes/holder.stl"/>

  <!-- Optional collision mesh -->
  <xacro:property name="holder_collision_mesh" value=""/>


  <!-- ==========================================
       BASE ROBOT
       ========================================== -->

  <!-- Base link is the center of the robot's bottom plate -->
  <link name="meca_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_base.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_base_collision.stl"/>
      </geometry>
    </collision>
  </link>


  <!-- ==========================================
       JOINT 1
       ========================================== -->

  <link name="meca_axis_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j1.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j1_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_1_joint" type="revolute">
    <origin xyz="0.012498 0 0.091" rpy="0 0 0"/>
    <parent link="meca_base_link"/>
    <child link="meca_axis_1_link"/>
    <axis xyz="0 0 1"/>

    <limit
        effort="10.0"
        velocity="2.61799"
        lower="-3.05433"
        upper="3.05433"/>
  </joint>


  <!-- ==========================================
       JOINT 2
       ========================================== -->

  <link name="meca_axis_2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j2.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j2_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_2_joint" type="revolute">
    <origin xyz="0 0 0.044" rpy="0 0 0"/>
    <parent link="meca_axis_1_link"/>
    <child link="meca_axis_2_link"/>
    <axis xyz="0 1 0"/>

    <limit
        effort="10.0"
        velocity="2.61799"
        lower="-1.22173048"
        upper="1.5708"/>
  </joint>


  <!-- ==========================================
       JOINT 3
       ========================================== -->

  <link name="meca_axis_3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j3.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j3_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_3_joint" type="revolute">
    <origin xyz="0 0 0.135" rpy="0 0 0"/>
    <parent link="meca_axis_2_link"/>
    <child link="meca_axis_3_link"/>
    <axis xyz="0 1 0"/>

    <limit
        effort="10.0"
        velocity="3.14159"
        lower="-2.35619"
        upper="1.22173048"/>
  </joint>


  <!-- ==========================================
       JOINT 4
       ========================================== -->

  <link name="meca_axis_4_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j4.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j4_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_4_joint" type="revolute">
    <origin xyz="0 0 0.038" rpy="0 0 0"/>
    <parent link="meca_axis_3_link"/>
    <child link="meca_axis_4_link"/>
    <axis xyz="1 0 0"/>

    <limit
        effort="10.0"
        velocity="5.23599"
        lower="-2.96706"
        upper="2.96706"/>
  </joint>


  <!-- ==========================================
       JOINT 5
       ========================================== -->

  <link name="meca_axis_5_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j5.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j5_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_5_joint" type="revolute">
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <parent link="meca_axis_4_link"/>
    <child link="meca_axis_5_link"/>
    <axis xyz="0 1 0"/>

    <limit
        effort="10.0"
        velocity="5.23599"
        lower="-2.00713"
        upper="2.00713"/>
  </joint>


  <!-- ==========================================
       JOINT 6 / FLANGE
       ========================================== -->

  <link name="meca_axis_6_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j6.dae"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mecademic_description/meshes/meca_500_r3_j6_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="meca_axis_6_joint" type="revolute">
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
    <parent link="meca_axis_5_link"/>
    <child link="meca_axis_6_link"/>
    <axis xyz="1 0 0"/>

    <limit
        effort="10.0"
        velocity="8.72665"
        lower="-3.14159"
        upper="3.14159"/>
  </joint>


  <!-- ==========================================
       TOOL REFERENCE FRAME
       ========================================== -->

  <!--
       Reference frame attached to the Meca500 flange.

       In this URDF representation, +X is used as the
       tool approach / insertion direction.

       No additional rotation is introduced here.
  -->

  <link name="meca_frf_link"/>

  <joint name="meca_frf_fixed" type="fixed">
    <parent link="meca_axis_6_link"/>
    <child link="meca_frf_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- ==========================================
       HOLDER
       ========================================== -->

  <!--
       Holder geometry is kept independently from tcp_link.

       Therefore, changing the calibrated TCP does not require
       changing the visual holder dimensions.
  -->

  <link name="holder_link">

    <visual>
      <origin xyz="${holder_xyz}" rpy="${holder_rpy}"/>

      <geometry>
        <mesh
            filename="${holder_visual_mesh}"
            scale="${mesh_scale}"/>
      </geometry>

      <material name="holder_gray">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>

    <!-- Collision box extends holder_len along +X -->
    <collision>
      <origin xyz="${holder_len/2.0} 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="${holder_len} 0.02 0.02"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="${holder_len/2.0} 0 0" rpy="0 0 0"/>

      <mass value="0.03"/>

      <inertia
          ixx="1e-5"
          ixy="0"
          ixz="0"
          iyy="1e-5"
          iyz="0"
          izz="1e-5"/>
    </inertial>

  </link>

  <joint name="holder_fixed" type="fixed">
    <parent link="meca_frf_link"/>
    <child link="holder_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- ==========================================
       NEEDLE
       ========================================== -->

  <!--
       tool0_link is used for the needle geometry.

       URDF cylinder primitives are aligned with the local Z axis.

       Ry(+90°) is therefore applied in needle_fixed so that
       tool0_link +Z aligns with holder_link +X, which is the
       approach direction used in this URDF.
  -->

  <link name="tool0_link">

    <visual>
      <origin
          xyz="0 0 ${needle_len/2.0}"
          rpy="0 0 0"/>

      <geometry>
        <cylinder
            length="${needle_len}"
            radius="${needle_rad}"/>
      </geometry>

      <material name="needle_steel">
        <color rgba="0.75 0.75 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin
          xyz="0 0 ${needle_len/2.0}"
          rpy="0 0 0"/>

      <geometry>
        <!-- Slightly enlarged collision radius for safer planning -->
        <cylinder
            length="${needle_len}"
            radius="${needle_rad*1.3}"/>
      </geometry>
    </collision>

    <inertial>
      <origin
          xyz="0 0 ${needle_len/2.0}"
          rpy="0 0 0"/>

      <mass value="0.005"/>

      <inertia
          ixx="1e-7"
          ixy="0"
          ixz="0"
          iyy="1e-7"
          iyz="0"
          izz="1e-7"/>
    </inertial>

  </link>

  <joint name="needle_fixed" type="fixed">
    <parent link="holder_link"/>
    <child link="tool0_link"/>

    <!--
         Needle base:
           holder_len = 60 mm along holder +X

         Rotation:
           Ry(+90°) makes tool0_link local +Z point
           along holder_link +X.
    -->

    <origin
        xyz="${holder_len} 0 0"
        rpy="0 1.57079632679 0"/>
  </joint>


  <!-- ==========================================
       CALIBRATED TCP
       ========================================== -->

  <!--
       TCP calibrated experimentally on the real Meca500:

         SetTrf(
             -0.053,
             -0.457,
             108.751,
             0,
             0,
             0
         ) mm

       Meca500 native tool convention:
         native +Z = approach direction

       URDF / MoveIt convention:
         URDF +X = approach direction

       Coordinate conversion:

         native X =  -0.053 mm  -> URDF Z = +0.053 mm
         native Y =  -0.457 mm  -> URDF Y = -0.457 mm
         native Z = 108.751 mm  -> URDF X = 108.751 mm

       Therefore the calibrated tcp_link position from the flange is:

         xyz =
         0.108751  -0.000457  0.000053   [m]

       tcp_link is attached directly to meca_frf_link.

       The holder and needle links remain a separate branch used
       to represent the physical tool geometry.
  -->

  <link name="tcp_link"/>

  <joint name="tcp_fixed" type="fixed">
    <parent link="meca_frf_link"/>
    <child link="tcp_link"/>

    <origin
        xyz="0.108751 -0.000457 0.000053"
        rpy="0 0 0"/>
  </joint>


</robot>
